# Secrets Template for QRCSatellite
# Copy this file to secrets.yaml and fill in your values

# WiFi Configuration
wifi_ssid: "YourWiFiNetwork"
wifi_password: "YourWiFiPassword"

# Fallback AP
ap_password: "FallbackPassword123"

# Home Assistant
ha_url: "http://homeassistant.local:8123"
api_key: "your_32_char_api_encryption_key_here"

# OTA
ota_password: "your_ota_password_here"

# Web Server (optional)
web_user: "admin"
web_pass: "admin"
